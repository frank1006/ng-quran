{
  "name": "ng-quran",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/write-public-env.mjs",
    "start": "ng serve --host 0.0.0.0",
    "start:https": "ng serve --host 0.0.0.0 --port 4200 --ssl --ssl-cert ssl/server.crt --ssl-key ssl/server.key",
    "prebuild": "node scripts/write-public-env.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:api": "vitest run --config vitest.api.config.mts"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@angular/service-worker": "^21.2.25",
    "@capacitor/core": "8.5.3",
    "@capacitor/geolocation": "8.2.2",
    "@supabase/supabase-js": "^2.117.2",
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "^1.6.1",
    "adhan": "4.4.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@angular/build": "^21.2.27",
    "@angular/cli": "^21.2.27",
    "@angular/compiler-cli": "^21.2.25",
    "@angular/pwa": "^21.2.27",
    "@types/web-push": "^3.6.4",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
