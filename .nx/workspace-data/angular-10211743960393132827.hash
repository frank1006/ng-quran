{
  "17513928794144506860": {
    ".": {
      "projectType": "application",
      "sourceRoot": "src",
      "targets": {
        "build": {
          "command": "ng build",
          "options": {
            "cwd": "."
          },
          "metadata": {
            "technologies": [
              "angular"
            ],
            "description": "Run the \"build\" target for \"ng-quran\".",
            "help": {
              "command": "npx ng run ng-quran:build --help",
              "example": {
                "options": {
                  "localize": true
                }
              }
            }
          },
          "dependsOn": [
            "^build"
          ],
          "outputs": [
            "{projectRoot}/dist/ng-quran"
          ],
          "cache": true,
          "inputs": [
            "production",
            "^production",
            {
              "externalDependencies": [
                "@angular/cli"
              ]
            }
          ],
          "configurations": {
            "production": {
              "command": "ng run ng-quran:build:production"
            },
            "development": {
              "command": "ng run ng-quran:build:development"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "command": "ng serve",
          "options": {
            "cwd": "."
          },
          "metadata": {
            "technologies": [
              "angular"
            ],
            "description": "Run the \"serve\" target for \"ng-quran\".",
            "help": {
              "command": "npx ng run ng-quran:serve --help",
              "example": {
                "options": {
                  "port": 4201
                }
              }
            }
          },
          "continuous": true,
          "configurations": {
            "production": {
              "command": "ng run ng-quran:serve:production"
            },
            "development": {
              "command": "ng run ng-quran:serve:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "command": "ng test",
          "options": {
            "cwd": "."
          },
          "metadata": {
            "technologies": [
              "angular"
            ],
            "description": "Run the \"test\" target for \"ng-quran\".",
            "help": {
              "command": "npx ng run ng-quran:test --help",
              "example": {
                "options": {
                  "coverage": true
                }
              }
            }
          },
          "cache": true,
          "inputs": [
            "default",
            "^production",
            {
              "externalDependencies": [
                "@angular/cli",
                "vitest"
              ]
            }
          ],
          "outputs": [
            "{workspaceRoot}/coverage/ng-quran"
          ]
        }
      }
    }
  },
