{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "ng-quran": {
      "projectType": "application",
      "schematics": {},
      "root": "apps/quranflow-web",
      "sourceRoot": "apps/quranflow-web/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/apps/quranflow-web",
            "index": "apps/quranflow-web/src/index.html",
            "browser": "apps/quranflow-web/src/main.ts",
            "tsConfig": "apps/quranflow-web/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/quranflow-web/public"
              }
            ],
            "styles": [
              "apps/quranflow-web/src/styles.css"
            ],
            "serviceWorker": "apps/quranflow-web/ngsw-config.json"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "11.5kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": true
                },
                "fonts": true
              },
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "ng-quran:build:production"
            },
            "development": {
              "buildTarget": "ng-quran:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
